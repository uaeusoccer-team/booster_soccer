<root BTCPP_format="4">
  <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />
  <include path="./subtrees/subtree_find_ball.xml" />

  <BehaviorTree ID="MainTree">
    <Sequence name="root">
      <ReactiveSequence _while="gc_game_state!='PLAY'" name="wait for operator play">
        <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
        <SetVelocity />
      </ReactiveSequence>

      <ReactiveSequence _while="gc_game_state=='PLAY'" name="solo chase and kick test">
        <CheckAndStandUp />
        <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
        <CalcKickDir />
        <StrikerDecide decision_out="{decision}"
                       decision_in="{decision}"
                       chase_threshold="0.80"
                       kick_range="0.55"
                       kick_yaw_abs="0.35"
                       kick_lateral_abs="0.22"
                       kick_dir_abs="0.60"
                       require_kick_direction="false"
                       solo_lead_when_com_disabled="true" />
        <SubTree ID="FindBall" _while="decision=='find'" _autoremap="true" />
        <SetVelocity _while="decision == 'assist'" />
        <Chase _while="decision == 'chase'"
               vx_limit="0.45"
               vy_limit="0.16"
               vtheta_limit="0.75"
               dist="0.35"
               safe_dist="0.6" />
        <Adjust _while="decision =='adjust'"
                turn_threshold="0.4"
                range="0.35"
                vx_limit="0.30"
                vy_limit="0.22"
                vtheta_limit="0.75"
                vtheta_factor="1.2"
                tangential_speed_far="0.22"
                tangential_speed_near="0.08"
                near_threshold="0.45"
                no_turn_threshold="0.08"
                turn_first_threshold="0.35" />
        <Kick _while="decision == 'kick'"
              speed_limit="0.55"
              min_msec_kick="650"
              msecs_stablize="250" />
        <Kick _while="decision == 'cross'"
              speed_limit="0.35"
              min_msec_kick="300"
              msecs_stablize="200" />
      </ReactiveSequence>
    </Sequence>
  </BehaviorTree>
</root>
