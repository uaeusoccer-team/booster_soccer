<root BTCPP_format="4">
  <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />

  <BehaviorTree ID="MainTree">
    <Sequence name="root">
      <ReactiveSequence _while="gc_game_state!='PLAY'" name="wait for operator play">
        <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
        <SetVelocity />
      </ReactiveSequence>

      <ReactiveSequence _while="gc_game_state=='PLAY'" name="visual kick test">
        <CheckAndStandUp />
        <SubTree ID="CamFindAndTrackBall" _autoremap="true" />

        <!-- Approach slowly. Kick is only allowed after operator PLAY and close-ball vision. -->
        <SimpleChase _while="ball_location_known &amp;&amp; ball_range &gt; 0.55"
                     vx_limit="0.12"
                     vy_limit="0.04"
                     vtheta_limit="0.45"
                     stop_dist="0.55"
                     stop_angle="0.08" />

        <!-- Use Booster's built-in visual kick motion instead of raw joint commands. -->
        <RLVisionKick _while="ball_location_known &amp;&amp; ball_range &lt;= 0.55"
                      min_msec_kick="1200"
                      max_msec_kick="4000"
                      range="1.0" />

        <SetVelocity _while="!ball_location_known" />
      </ReactiveSequence>
    </Sequence>
  </BehaviorTree>
</root>
