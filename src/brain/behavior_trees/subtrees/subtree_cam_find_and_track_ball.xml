<!-- Cam find and track ball -->

<root BTCPP_format="4" >
  <BehaviorTree ID="CamFindAndTrackBall">
     <Sequence name="root">
         <IfThenElse>
             <ScriptCondition        name="Ball visible?" code="ball_visible" />
             <Sequence               name="[Yes] -> Track visible ball" >
                <CamTrackBall theta="{tracking_theta}" />
             </Sequence>
             <Sequence               name="[No] -> Find ball immediately">
                <CamFindBall theta="{tracking_theta}" />
             </Sequence>
         </IfThenElse>
     </Sequence>
  </BehaviorTree>
</root>
