<root BTCPP_format="4">
  <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />

  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="clear_walk_ball_search">
      <CheckAndStandUp />
      <SubTree ID="CamFindAndTrackBall" _autoremap="true" />

      <SetVelocity _while="!ball_location_known"
                   x="0.0"
                   y="0.0"
                   theta="0.25" />

      <Chase _while="ball_location_known"
             vx_limit="0.20"
             vy_limit="0.06"
             vtheta_limit="0.6"
             dist="0.5"
             safe_dist="0.8" />
    </ReactiveSequence>
  </BehaviorTree>
</root>
