<root BTCPP_format="4">
  <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />

  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="clear_walk_ball_search">
      <CheckAndStandUp />
      <SubTree ID="CamFindAndTrackBall" _autoremap="true" />

      <WalkInClearDirection _while="!ball_location_known"
                            vx="0.12"
                            vy_limit="0.05"
                            vtheta_limit="0.35"
                            safe_dist="1.0"
                            avoid_speed_scale="0.7"
                            blocked_turn_speed="0.18"
                            search_turn_speed="0.0" />

      <Chase _while="ball_location_known"
             vx_limit="0.20"
             vy_limit="0.06"
             vtheta_limit="0.6"
             dist="0.5"
             safe_dist="0.8" />
    </ReactiveSequence>
  </BehaviorTree>
</root>
